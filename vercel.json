{
  "version": 2,
  "name": "ai-product-workshop",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/workshop", "destination": "/workshop/index.html" },
    { "source": "/sandbox", "destination": "/sandbox/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
